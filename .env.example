# Configuración del backend de G_Computacional.
# Copie este archivo a .env y ajuste los valores. El .env no se versiona.
# Las variables ya presentes en el entorno del proceso tienen prioridad sobre
# este archivo, por lo que un despliegue puede inyectarlas sin editarlo.

# --- Django -----------------------------------------------------------------
# Genere una clave propia, por ejemplo con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=reemplace-esta-clave-por-una-generada
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Orígenes de confianza para formularios/CSRF cuando el frontend corra aparte.
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Base de datos ----------------------------------------------------------
# Por omisión SQLite en database/data/db.sqlite3 (ruta relativa a la raíz del repo).
DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=database/data/db.sqlite3
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_CONN_MAX_AGE=0
# Carpeta donde se guardan las copias de respaldo de la base.
DATABASE_BACKUPS_DIR=database/backups

# Ejemplo para migrar más adelante a PostgreSQL:
# DATABASE_ENGINE=django.db.backends.postgresql
# DATABASE_NAME=g_computacional
# DATABASE_USER=g_computacional
# DATABASE_PASSWORD=cambie-esta-contrasena
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=5432

# --- Localización -----------------------------------------------------------
LANGUAGE_CODE=es-co
TIME_ZONE=America/Bogota

# --- API --------------------------------------------------------------------
API_PAGE_SIZE=25
API_THROTTLE_AUTH=10/minute
API_THROTTLE_REGISTRATION=5/hour

# --- Archivos estáticos y media --------------------------------------------
STATIC_URL=static/
STATIC_ROOT=staticfiles
MEDIA_URL=media/
MEDIA_ROOT=media

# --- Correo -----------------------------------------------------------------
# Para enviar correos reales con Gmail: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend,
# EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_USE_TLS=True, EMAIL_HOST_USER=tu_correo@gmail.com,
# EMAIL_HOST_PASSWORD=<contraseña de aplicación de 16 dígitos, no tu clave normal>.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=no-reply@g-computacional.local

# URL del frontend (Vite) para construir enlaces dentro de los correos.
FRONTEND_URL=http://localhost:5173

# --- Seguridad en producción (se aplican solo con DEBUG=False) --------------
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
